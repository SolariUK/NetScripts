#!/bin/bash
#
# Script:       fullportstatus
# Version:      v1.4
#
# Portable Bash/awk rewrite:
#   - numeric OIDs and enums regardless of installed MIBs (-Oqne)
#   - no CSV parsing / comma delimiter
#   - no chained join commands
#   - numeric enum-to-text mapping in awk
#   - private temporary directory with automatic cleanup
#

set -o pipefail

USAGE="Usage: $0 [options] devicename
       $0 [options] -h devicename

Options:
 -3          use SNMPv3
 -l          use low-speed ifSpeed OID for older devices
 -n          do not colourise
 -f 'regex'  show only interfaces whose ifDescr matches regex
 -h name     specify hostname

The -f option accepts a POSIX awk extended regular expression.
Quoting the expression is recommended to prevent shell expansion.

Examples:
  $0 router1
  $0 -n router1
  $0 router1 -f '^GigabitEthernet'
  $0 -f '^ge-' router2
  $0 -f '^ge-[0-9]+/[0-9]+/[0-9]+$' router2
"

LOWSPEED=0
COLOURISE=1
USE_V3=0
DEVICE=""

COMMUNITY="public"
RETRIES=0
TIMEOUT=3
SNMPVER="2c"

SNMPUSER="V3USERNAME"   # SNMPv3 user
SNMPAUTH="V3AUTH"       # SNMPv3 auth password
SNMPPRIV="V3PRIV"       # SNMPv3 privacy password

#
# Numeric IF-MIB OIDs.
#
# Leading dots are deliberately omitted here.  awk normalises the
# OIDs returned by Net-SNMP before comparison.
#
IFDESCROID="1.3.6.1.2.1.2.2.1.2"
IFADMINOID="1.3.6.1.2.1.2.2.1.7"
IFOPEROID="1.3.6.1.2.1.2.2.1.8"
IFSPEEDOID="1.3.6.1.2.1.2.2.1.5"
IFHIGHSPEEDOID="1.3.6.1.2.1.31.1.1.1.15"
IFALIASOID="1.3.6.1.2.1.31.1.1.1.18"

FILTER=""

#
# Command-line options
#
while [ "$#" -gt 0 ]
do
    case "$1" in
        -3)
            USE_V3=1
            shift
            ;;

        -l)
            LOWSPEED=1
            shift
            ;;

        -n)
            COLOURISE=0
            shift
            ;;

        -f)
            if [ "$#" -lt 2 ]; then
                printf 'Option -f requires a regular expression.\n' >&2
                printf '%s\n' "$USAGE" >&2
                exit 1
            fi

            FILTER=$2
            shift 2
            ;;

        -h)
            if [ "$#" -lt 2 ]; then
                printf 'Option -h requires a hostname.\n' >&2
                printf '%s\n' "$USAGE" >&2
                exit 1
            fi

            DEVICE=$2
            shift 2
            ;;

        --)
            shift
            break
            ;;

        -*)
            printf 'Unknown option: %s\n' "$1" >&2
            printf '%s\n' "$USAGE" >&2
            exit 1
            ;;

        *)
            if [ -n "$DEVICE" ]; then
                printf 'Unexpected argument: %s\n' "$1" >&2
                printf '%s\n' "$USAGE" >&2
                exit 1
            fi

            DEVICE=$1
            shift
            ;;
    esac
done

if [ "$#" -gt 0 ]; then
    if [ -n "$DEVICE" ]; then
        printf 'Unexpected argument: %s\n' "$1" >&2
        printf '%s\n' "$USAGE" >&2
        exit 1
    fi

    DEVICE=$1
    shift
fi

if [ "$#" -gt 0 ]; then
    printf 'Unexpected argument: %s\n' "$1" >&2
    printf '%s\n' "$USAGE" >&2
    exit 1
fi

if [ -z "$DEVICE" ]; then
    printf 'Expected argument (device name)\n' >&2
    printf '%s\n' "$USAGE" >&2
    exit 1
fi


# Basic dependency check.
#
if ! command -v snmpbulkwalk >/dev/null 2>&1; then
    printf 'snmpbulkwalk was not found in PATH.\n' >&2
    exit 1
fi


#
# Only check terminal width when stdout is actually a terminal.
#
if [ "$COLOURISE" -eq 1 ] &&
   [ -t 1 ] &&
   command -v tput >/dev/null 2>&1
then
    COLS=$(tput cols 2>/dev/null || printf '0')

    if [ "$COLS" -gt 0 ] && [ "$COLS" -lt 133 ]; then
        printf '\033[31;1mWARNING - \033[37mTerminal may not be wide enough for clean output.\033[0m\n' >&2
    fi
fi


#
# Build the Net-SNMP command as a Bash array.
#
# -Oqne means:
#
#   q  quick/easily parsed output
#   n  numeric OIDs
#   e  numeric enum values
#
# Consequently parsing does not depend on local MIB availability.
#
if [ "$USE_V3" -eq 1 ]; then

    SNMPCMD=(
        snmpbulkwalk
        -Oqne
        -t "$TIMEOUT"
        -r "$RETRIES"
        -v3
        -u "$SNMPUSER"
        -l authPriv
        -a SHA
        -A "$SNMPAUTH"
        -x AES
        -X "$SNMPPRIV"
    )

else

    SNMPCMD=(
        snmpbulkwalk
        -Oqne
        -t "$TIMEOUT"
        -r "$RETRIES"
        -v "$SNMPVER"
        -c "$COMMUNITY"
    )

fi


if [ "$USE_V3" -eq 1 ]; then
    if [ "$COLOURISE" -eq 1 ] && [ -t 1 ]; then
        printf 'Using \033[31;1mSNMPv3\033[0m\n'
    else
        printf 'Using SNMPv3\n'
    fi
fi


#
# Private temporary directory.
#
# This makes simultaneous invocations safe and guarantees cleanup if
# the script is interrupted.
#
TMPBASE=${TMPDIR:-/tmp}

TMPDIR_RUN=$(mktemp -d "$TMPBASE/fullportstatus.XXXXXX") || {
    printf 'Unable to create temporary directory under %s\n' "$TMPBASE" >&2
    exit 1
}

trap 'rm -rf "$TMPDIR_RUN"' EXIT HUP INT TERM

DESCR_FILE="$TMPDIR_RUN/descr"
ADMIN_FILE="$TMPDIR_RUN/admin"
OPER_FILE="$TMPDIR_RUN/oper"
SPEED_FILE="$TMPDIR_RUN/speed"
ALIAS_FILE="$TMPDIR_RUN/alias"

ROWS_FILE="$TMPDIR_RUN/rows"
SORTED_FILE="$TMPDIR_RUN/rows.sorted"


#
# Perform a required SNMP walk.
#
walk_required()
{
    oid=$1
    outfile=$2
    label=$3

    if ! LC_ALL=C "${SNMPCMD[@]}" \
         "$DEVICE" "$oid" >"$outfile"
    then
        printf 'SNMP walk failed for %s (%s) on %s\n' \
               "$label" "$oid" "$DEVICE" >&2
        exit 1
    fi

    if [ ! -s "$outfile" ]; then
        printf 'SNMP walk returned no data for %s (%s) on %s\n' \
               "$label" "$oid" "$DEVICE" >&2
        exit 1
    fi
}


#
# Perform an optional SNMP walk.
#
# I have made ifAlias optional since some older implementations may not
# provide useful data here.  Failure therefore results in blank aliases
# rather than failure of the whole report.
#
walk_optional()
{
    oid=$1
    outfile=$2
    label=$3

    if ! LC_ALL=C "${SNMPCMD[@]}" \
         "$DEVICE" "$oid" >"$outfile"
    then
        printf 'WARNING: SNMP walk failed for optional %s (%s); leaving values blank.\n' \
               "$label" "$oid" >&2
        : >"$outfile"
    fi
}


#
# Collect interface data.
#
walk_required "$IFDESCROID" "$DESCR_FILE" "ifDescr"
walk_required "$IFADMINOID" "$ADMIN_FILE" "ifAdminStatus"
walk_required "$IFOPEROID"  "$OPER_FILE"  "ifOperStatus"


#
# Select speed table.
#
if [ "$LOWSPEED" -eq 1 ]; then

    SPEED_OID=$IFSPEEDOID
    SPEED_MODE="low"
    SPEED_LABEL="ifSpeed"

else

    SPEED_OID=$IFHIGHSPEEDOID
    SPEED_MODE="high"
    SPEED_LABEL="ifHighSpeed"

fi

walk_required "$SPEED_OID" "$SPEED_FILE" "$SPEED_LABEL"
walk_optional "$IFALIASOID" "$ALIAS_FILE" "ifAlias"


#
# Internal field separator.
#
# This is ASCII Unit Separator (0x1f).
#
# Commas, spaces, colons etc. in interface descriptions and aliases are
# therefore harmless.
#
SEP=$(printf '\037')


#
# Parse all five walks in a single POSIX-awk program.
#
# Each file contains raw snmpbulkwalk -Oqne output.
#
# The numeric OID prefix identifies the column and the remainder of the
# OID is the ifIndex.
#
awk \
    -v SEP="$SEP" \
    -v descr_file="$DESCR_FILE" \
    -v admin_file="$ADMIN_FILE" \
    -v oper_file="$OPER_FILE" \
    -v speed_file="$SPEED_FILE" \
    -v alias_file="$ALIAS_FILE" \
    -v descr_oid="$IFDESCROID" \
    -v admin_oid="$IFADMINOID" \
    -v oper_oid="$IFOPEROID" \
    -v speed_oid="$SPEED_OID" \
    -v alias_oid="$IFALIASOID" \
    -v speed_mode="$SPEED_MODE" '

#
# Net-SNMP may emit numeric OIDs with a leading ".".
#
function normalise_oid(s)
{
    sub(/^\./, "", s)
    return s
}


#
# Strip the exact table OID prefix and return the ifIndex.
#
function index_from_oid(oid, prefix, p)
{
    oid = normalise_oid(oid)
    prefix = normalise_oid(prefix)

    p = prefix "."

    if (substr(oid, 1, length(p)) != p)
        return ""

    return substr(oid, length(p) + 1)
}


#
# DisplayString output normally has one surrounding pair of quotes.
#
# Remove those while leaving commas, spaces and punctuation untouched.
#
function unquote(s, first, last)
{
    if (length(s) >= 2) {

        first = substr(s, 1, 1)
        last  = substr(s, length(s), 1)

        if ((first == "\"" && last == "\"") ||
            (first == "\047" && last == "\047"))
        {
            return substr(s, 2, length(s) - 2)
        }
    }

    return s
}


#
# ifAdminStatus:
#
#     up(1)
#     down(2)
#     testing(3)
#
function admin_name(n)
{
    n += 0

    if (n == 1)
        return "up"

    if (n == 2)
        return "down"

    if (n == 3)
        return "testing"

    return "unknown(" n ")"
}


#
# ifOperStatus:
#
#     up(1)
#     down(2)
#     testing(3)
#     unknown(4)
#     dormant(5)
#     notPresent(6)
#     lowerLayerDown(7)
#
function oper_name(n)
{
    n += 0

    if (n == 1)
        return "up"

    if (n == 2)
        return "down"

    if (n == 3)
        return "testing"

    if (n == 4)
        return "unknown"

    if (n == 5)
        return "dormant"

    if (n == 6)
        return "notPresent"

    if (n == 7)
        return "lowerLayerDown"

    return "unknown(" n ")"
}


#
# Preserve the display conventions of the original script.
#
# ifHighSpeed is expressed in millions of bits/sec.
#
# ifSpeed is expressed directly in bits/sec.
#
function format_speed(n)
{
    n += 0

    #
    # A zero speed is commonly reported for logical/pseudo interfaces
    # where an interface speed is not meaningful.
    #
    if (n == 0)
        return "-"

    if (speed_mode == "high") {

        if (n <= 100)
            return sprintf("%gm", n)

        return sprintf("%gg", n / 1000)
    }

    if (n <= 100000000)
        return sprintf("%gm", n / 1000000)

    return sprintf("%gg", n / 1000000000)
}

#
# Under -Oqne the first whitespace-separated item is the numeric OID.
#
# Everything following the first run of whitespace is the value.  This
# deliberately does NOT split the value itself, so:
#
#     "Uplink to core, primary"
#
# remains a single value.
#
function split_line(line, parts, value, pos)
{
    pos = match(line, /[ \t]+/)

    if (!pos)
        return 0

    parts[1] = substr(line, 1, pos - 1)

    value = substr(line, pos)
    sub(/^[ \t]+/, "", value)

    parts[2] = value

    return 1
}


{
    delete part

    if (!split_line($0, part))
        next

    oid = part[1]
    value = part[2]


    #
    # ifDescr
    #
    if (FILENAME == descr_file) {

        idx = index_from_oid(oid, descr_oid)

        if (idx != "") {
            descr[idx] = unquote(value)
            seen[idx] = 1
        }

        next
    }


    #
    # ifAdminStatus
    #
    if (FILENAME == admin_file) {

        idx = index_from_oid(oid, admin_oid)

        if (idx != "")
            admin[idx] = admin_name(value)

        next
    }


    #
    # ifOperStatus
    #
    if (FILENAME == oper_file) {

        idx = index_from_oid(oid, oper_oid)

        if (idx != "")
            oper[idx] = oper_name(value)

        next
    }


    #
    # ifSpeed / ifHighSpeed
    #
    if (FILENAME == speed_file) {

        idx = index_from_oid(oid, speed_oid)

        if (idx != "")
            speed[idx] = format_speed(value)

        next
    }


    #
    # ifAlias
    #
    if (FILENAME == alias_file) {

        idx = index_from_oid(oid, alias_oid)

        if (idx != "")
            alias[idx] = unquote(value)

        next
    }
}


END {

    count = 0

    #
    # ifDescr acts as our master list of interfaces.
    #
    for (idx in seen) {

        count++


        #
        # Missing required values are noteworthy, but do not throw away
        # the remainder of the report.
        #
        if (!(idx in admin))
            printf "WARNING: no ifAdminStatus for ifIndex %s\n", \
                   idx > "/dev/stderr"

        if (!(idx in oper))
            printf "WARNING: no ifOperStatus for ifIndex %s\n", \
                   idx > "/dev/stderr"

        if (!(idx in speed))
            printf "WARNING: no speed value for ifIndex %s\n", \
                   idx > "/dev/stderr"


        printf "%s%s%s%s%s%s%s%s%s%s%s\n", \
               idx, SEP, \
               descr[idx], SEP, \
               admin[idx], SEP, \
               oper[idx], SEP, \
               speed[idx], SEP, \
               alias[idx]
    }


    if (count == 0) {
        print "No valid ifDescr rows were parsed from SNMP output." \
              > "/dev/stderr"
        exit 2
    }
}

' \
"$DESCR_FILE" \
"$ADMIN_FILE" \
"$OPER_FILE" \
"$SPEED_FILE" \
"$ALIAS_FILE" >"$ROWS_FILE" || exit 1


#
# awk associative arrays are deliberately unordered.
#
# Sort only our finished rows by numeric ifIndex.  The script therefore
# makes no assumptions at all about the ordering of the five walks.
#
LC_ALL=C sort \
    -t "$SEP" \
    -k1,1n \
    "$ROWS_FILE" >"$SORTED_FILE" || exit 1


#
# Output formats.
#
DOWNDOWNFMT='%-10.10s %-28.28s \033[37m%-14.14s %-14.14s\033[0m %-8.8s %-64.64s\n'

UPDOWNFMT='%-10.10s %-28.28s \033[32;1m%-14.14s\033[0m \033[31;1m%-14.14s\033[0m %-8.8s %-64.64s\n'

UPUPFMT='%-10.10s %-28.28s \033[32;1m%-14.14s\033[0m \033[32;1m%-14.14s\033[0m %-8.8s %-64.64s\n'

NORMFMT='%-10.10s %-28.28s \033[36m%-14.14s\033[0m \033[36m%-14.14s\033[0m %-8.8s %-64.64s\n'

BWFMT='%-10.10s %-28.28s %-14.14s %-14.14s %-8.8s %-64.64s\n'

#
# Disable colours for -n or when stdout is redirected.
#
if [ "$COLOURISE" -eq 0 ] || [ ! -t 1 ]; then

    DOWNDOWNFMT=$BWFMT
    UPDOWNFMT=$BWFMT
    UPUPFMT=$BWFMT
    NORMFMT=$BWFMT

fi


#
# Header.
#
printf '%-10.10s %-28.28s %-14.14s %-14.14s %-8.8s %-32.32s\n' \
       'ifIndex' \
       'ifDescr' \
       'ifAdmin' \
       'ifOper' \
       'ifSpeed' \
       'ifAlias'

#
# Colour/status formatting.
#
awk \
    -F "$SEP" \
    -v filter="$FILTER" \
    -v down_fmt="$DOWNDOWNFMT" \
    -v updown_fmt="$UPDOWNFMT" \
    -v upup_fmt="$UPUPFMT" \
    -v norm_fmt="$NORMFMT" '

{

    if (filter != "" && $2 !~ filter)
        next


    if ($3 == "down" && $4 == "down") {

        printf down_fmt, \
               $1, $2, $3, $4, $5, $6

        next
    }


    if ($3 == "up" && $4 == "up") {

        printf upup_fmt, \
               $1, $2, $3, $4, $5, $6

        next
    }


    if ($3 == "up" && $4 == "down") {

        printf updown_fmt, \
               $1, $2, $3, $4, $5, $6

        next
    }


    printf norm_fmt, \
           $1, $2, $3, $4, $5, $6
}

' "$SORTED_FILE"
